{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "description": "A walkable 2D office where every AI coding agent running in Herdr is a character",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"Agent Office\" --platform=darwin --arch=arm64 --out=dist --overwrite --no-asar --icon=assets/icon.icns --ignore=^/scripts --ignore=^/dist --ignore=^/node_modules/node-pty/prebuilds/win32- --ignore=^/node_modules/node-pty/third_party --ignore=^/node_modules/node-pty/deps",
    "install-app": "npm run package && rm -rf \"/Applications/Agent Office.app\" && ditto \"dist/Agent Office-darwin-arm64/Agent Office.app\" \"/Applications/Agent Office.app\" && rm -rf dist",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper",
    "hooks:install": "python3 -I scripts/hooks.py install",
    "hooks:uninstall": "python3 -I scripts/hooks.py uninstall",
    "icon": "uv run --quiet --with pillow python scripts/make-icon.py assets/icon.icns"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^38.8.6"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
